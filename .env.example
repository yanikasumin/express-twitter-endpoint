# Copy this file to ".env" and adjust the values if needed.
# This service needs NO X API key, token or account: nothing secret
# belongs in this file. (APP_API_KEY below is your own optional gate
# for this service, unrelated to X.)

# Username (without "@") whose latest tweet should be returned
TWITTER_USERNAME=elonmusk

# How retweets / replies are handled by default.
# Allowed values: include | exclude   (can be overridden per-request, see README)
EXCLUDE_RETWEETS=exclude
EXCLUDE_REPLIES=exclude

# In-memory cache TTL in seconds (protects against the upstream
# feed's per-IP rate limit)
CACHE_TTL_SECONDS=60

# Per-request timeout for upstream feed calls, in milliseconds
UPSTREAM_TIMEOUT_MS=10000

# How many times a rate-limited (HTTP 429) upstream call is retried
# (honouring Retry-After / the rate-limit reset time) before giving up
UPSTREAM_MAX_RETRIES=3

# Cap on the TOTAL time (ms) spent waiting between 429 retries of one
# operation. Retrying stops early once the next wait would exceed
# this budget.
UPSTREAM_RETRY_BUDGET_MS=90000

# Overall deadline (ms) for handling one /latest-tweet request: every
# upstream attempt plus every retry wait must fit inside it. Attempts
# are cut off at the deadline.
REQUEST_DEADLINE_MS=60000

# Optional shared secret for /latest-tweet. When set, callers must send it
# in the "x-api-key" header (401 otherwise). Leave unset for local use.
# APP_API_KEY=<redacted>

# Port the server listens on
PORT=3000

# Interface the standalone server binds to. Default is loopback only
# (local / trusted-network use). Set to 0.0.0.0 to expose the server —
# and set APP_API_KEY above when you do.
HOST=127.0.0.1
