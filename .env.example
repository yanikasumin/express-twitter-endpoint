# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env to version control.

# Bearer Token from your X Developer App (required)
# X Developer Portal -> your Project/App -> Keys and tokens -> Bearer Token
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAA_DUMMY_TOKEN_REPLACE_ME

# Username (without "@") whose latest tweet should be returned
TWITTER_USERNAME=elonmusk

# How retweets / replies are handled by default.
# Allowed values: include | exclude   (can be overridden per-request, see README)
EXCLUDE_RETWEETS=exclude
EXCLUDE_REPLIES=exclude

# In-memory cache TTL in seconds (protects against X API rate limits)
CACHE_TTL_SECONDS=60

# Per-request timeout for X API calls, in milliseconds
TWITTER_TIMEOUT_MS=10000

# How many times a rate-limited (HTTP 429) X API call is retried with
# exponential backoff (honouring Retry-After) before giving up
TWITTER_MAX_RETRIES=3

# Cap on the TOTAL time (ms) spent waiting between 429 retries of one call.
# Retrying stops early once the next wait would exceed this budget.
TWITTER_RETRY_BUDGET_MS=90000

# Overall deadline (ms) for handling one /latest-tweet request: the
# username lookup and the timeline fetch share a single deadline, and
# every attempt plus every retry wait of both calls must fit inside it.
# Attempts are cut off at the deadline.
TWITTER_DEADLINE_MS=60000

# Optional shared secret for /latest-tweet. When set, callers must send it
# in the "x-api-key" header (401 otherwise). Leave unset for local use.
# APP_API_KEY=change-me-to-a-long-random-string

# Port the server listens on
PORT=3000
